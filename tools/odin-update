#!/bin/bash
set -euo pipefail

# odin-update — Install or update the Odin compiler from official prebuilts
# Supports stable (GitHub tagged releases) and nightly (daily builds from odin-lang.org)
#
# Designed for curl ... | bash sharing and confident use on Linux and macOS.
# - Respects $ODIN_ROOT (ODINHOME is legacy, noted but not preferred)
# - Safe staging + verification before any change to live install
# - SHA256 local verification of the downloaded archive
# - Backup of previous working version + rollback trap on failure (update path only)
# - First-time install prompts for location (default ~/.local/Odin) when interactive
# - Creates ~/.config/odin/conf skeleton on first successful install (commented)
# - Creates symlink ~/.local/bin/odin if ~/.local/bin/ directory already exists
# - --channel=stable|nightly and --keep=N flags (defaults: stable, 1)
# - Clear final instructions for current shell + future shells (no auto rc editing
#   to keep the script simple and safe per project guidelines)
# - Smart sudo: detects already-root, re-offers prompt on updates to system paths
#
# Non-obvious decisions documented in comments below.
# External deps: curl, tar, mktemp, uname, which, jq (only for stable channel;
#   install with apt/brew/pacman if missing — common for such scripts).
# SHA tools: sha256sum (Linux) or shasum (macOS) — both common.
#
# Project rules followed: small testable increments, simplicity preferred,
# Linux/macOS parity, first-time vs update paths clearly separated,
# self-contained, ask before adding complex logic.

# -------------------------------------------------------------------
# Defaults (easy to change, used by first-time and flag logic)
# -------------------------------------------------------------------
DEFAULT_INSTALL_DIR="${HOME}/.local/Odin"
CONFIG_DIR="${HOME}/.config/odin"
CONFIG_FILE="${CONFIG_DIR}/conf"
KEEP_DEFAULT=1
CHANNEL_DEFAULT="stable"

# Nightly discovery (lightweight, no extra deps). The page lists dated
# sections newest-first. We take the first matching filename.
# If the download base changes, update this or add --nightly-base override later.
NIGHTLY_DOCS_URL="https://odin-lang.org/docs/nightly/"
NIGHTLY_DOWNLOAD_BASE="https://odin-lang.org/download/nightly"

# -------------------------------------------------------------------
# State (kept minimal; set early, read by many functions)
# -------------------------------------------------------------------
CHANNEL="$CHANNEL_DEFAULT"
KEEP="$KEEP_DEFAULT"
INSTALL_DIR=""
OS_NAME=""
ARCH_SUFFIX=""
IS_FIRST_INSTALL=false
SUDO_CMD=""          # only set to "sudo" if user explicitly consents (or empty if already root)
TEMP_DIR=""
STAGING_DIR=""
BACKUP=""
LATEST=""
ASSET=""
URL=""

# For rollback trap (only meaningful on update attempts)
UPDATE_SUCCEEDED=false
UPDATE_IN_PROGRESS=false

# Capture original env value before we export anything (for messaging only)
ORIGINAL_ODIN_ROOT="${ODIN_ROOT:-}"

# -------------------------------------------------------------------
# Usage / help (kept short and accurate)
# -------------------------------------------------------------------
print_usage() {
    cat <<EOF
odin-update — install or update Odin (stable or nightly)

Usage: odin-update [--channel=stable|nightly] [--keep=N]

  --channel   stable (default; GitHub tagged dev- releases)
              nightly (daily builds from odin-lang.org)
  --keep      number of previous .bak directories to keep (default: 1)
  -h, --help  this help

First-time: prompts for install dir if run interactively.
Update: staging + verify + backup + atomic replace + rollback on failure.
After success: symlink in ~/.local/bin (if dir exists) + config skeleton
                + clear instructions for PATH/ODIN_ROOT.

Linux and macOS only. Windows users: use the GitHub releases zip directly.
EOF
}

# -------------------------------------------------------------------
# Argument parsing (small, strict, supports both --foo=bar and --foo bar)
# -------------------------------------------------------------------
parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --channel=*) CHANNEL="${1#*=}" ;;
            --channel)   shift; CHANNEL="${1:-$CHANNEL_DEFAULT}" ;;
            --keep=*)    KEEP="${1#*=}" ;;
            --keep)      shift; KEEP="${1:-$KEEP_DEFAULT}" ;;
            -h|--help)   print_usage; exit 0 ;;
            *)
                echo "Error: unknown argument '$1'"
                print_usage
                exit 1
                ;;
        esac
        shift
    done

    case "$CHANNEL" in
        stable|nightly) ;;
        *)
            echo "Error: --channel must be 'stable' or 'nightly'"
            exit 1
            ;;
    esac

    if ! [[ "$KEEP" =~ ^[0-9]+$ ]] || [[ "$KEEP" -lt 0 ]]; then
        echo "Error: --keep must be a non-negative integer"
        exit 1
    fi
}

# -------------------------------------------------------------------
# Platform detection (unchanged from proven original — Linux/macOS only)
# -------------------------------------------------------------------
detect_platform() {
    local os_raw arch_raw
    os_raw=$(uname -s | tr '[:upper:]' '[:lower:]')
    arch_raw=$(uname -m | tr '[:upper:]' '[:lower:]')

    case "$os_raw" in
        darwin*) OS_NAME="macos" ;;
        linux*)  OS_NAME="linux" ;;
        mingw*|msys*|cygwin*)
            echo "Windows detected."
            echo "Please download the Windows zip from:"
            echo "  https://github.com/odin-lang/Odin/releases/latest"
            echo "Extract it and add the folder to your PATH."
            exit 0
            ;;
        *)
            echo "Unsupported OS: $(uname -s)"
            echo "Supported: Linux and macOS (prebuilts)"
            exit 1
            ;;
    esac

    case "$arch_raw" in
        x86_64|amd64)  ARCH_SUFFIX="amd64" ;;
        arm64|aarch64) ARCH_SUFFIX="arm64" ;;
        *)
            echo "Unsupported architecture: $arch_raw"
            exit 1
            ;;
    esac
}

# -------------------------------------------------------------------
# Portable absolute path (works even if target does not exist yet)
# -------------------------------------------------------------------
abs_path() {
    local p="$1"
    p="${p/#\~/$HOME}"
    if [[ "$p" != /* ]]; then
        p="$(pwd -P)/$p"
    fi
    p="${p%/}"
    echo "$p"
}

# -------------------------------------------------------------------
# Determine install location + set IS_FIRST_INSTALL
# (first-time vs update paths diverge here)
# -------------------------------------------------------------------
determine_install_dir() {
    if [[ -n "${ODIN_ROOT:-}" ]]; then
        INSTALL_DIR="$ODIN_ROOT"
    elif [[ -n "${ODINHOME:-}" ]]; then
        INSTALL_DIR="$ODINHOME"
        echo "Note: ODINHOME is legacy; prefer ODIN_ROOT."
    else
        if which odin >/dev/null 2>&1; then
            local odin_path
            odin_path=$(which odin)
            INSTALL_DIR=$(dirname "$odin_path")
        else
            IS_FIRST_INSTALL=true
            if [[ -t 0 ]]; then
                echo ""
                echo "No Odin found via \`which odin\` and no \$ODIN_ROOT set."
                echo "Performing first-time installation."
                read -r -p "Install directory [default: $DEFAULT_INSTALL_DIR]: " user_dir
                INSTALL_DIR="${user_dir:-$DEFAULT_INSTALL_DIR}"
            else
                # Non-interactive safe default (curl | bash etc.)
                INSTALL_DIR="$DEFAULT_INSTALL_DIR"
            fi
        fi
    fi

    INSTALL_DIR=$(abs_path "$INSTALL_DIR")

    if [[ ! -x "$INSTALL_DIR/odin" ]]; then
        IS_FIRST_INSTALL=true
    fi
}

# -------------------------------------------------------------------
# Smart sudo handling (best practice)
# - If already root → no prompt, just proceed
# - If normal user and target not writable → offer interactive sudo once
# - Called before any write (backup or commit)
# -------------------------------------------------------------------
ensure_sudo_if_needed() {
    # Already root? Nothing to do.
    if [[ $EUID -eq 0 ]]; then
        SUDO_CMD=""
        return 0
    fi

    # Already have sudo from a previous prompt in this run?
    if [[ -n "$SUDO_CMD" ]]; then
        return 0
    fi

    local parent
    parent=$(dirname "$INSTALL_DIR")

    # Can we write without elevation?
    if { [[ -d "$INSTALL_DIR" && -w "$INSTALL_DIR" ]] || [[ ! -e "$INSTALL_DIR" && -w "$parent" ]]; }; then
        return 0
    fi

    # Need elevation — offer prompt (only if interactive)
    if [[ -t 0 ]]; then
        echo ""
        echo "⚠️  Need elevated privileges to write to: $INSTALL_DIR"
        read -r -p "Use sudo for the remaining install/update steps? [y/N] " ans
        if [[ "$ans" =~ ^[Yy] ]]; then
            if sudo -v; then
                SUDO_CMD="sudo"
                echo "   sudo will be used. Ownership will be returned to your user afterwards."
                return 0
            else
                echo "   sudo authentication failed (or cancelled)."
            fi
        fi
    fi

    echo ""
    echo "Cannot write to $INSTALL_DIR without elevated privileges."
    echo "Re-run with a writable location (e.g. ~/.local/Odin) or as root/sudo."
    exit 1
}

# -------------------------------------------------------------------
# Current version (forced ODIN_ROOT protects against stale user env)
# -------------------------------------------------------------------
get_current_version() {
    if [[ -x "$INSTALL_DIR/odin" ]]; then
        ODIN_ROOT="$INSTALL_DIR" "$INSTALL_DIR/odin" version 2>/dev/null \
            | head -n1 | awk '{print $NF}'
    else
        echo "none"
    fi
}

# -------------------------------------------------------------------
# Release info (stable = GitHub latest + jq; nightly = docs page + grep)
# -------------------------------------------------------------------
get_latest_release_info() {
    if [[ "$CHANNEL" == "stable" ]]; then
        local json
        json=$(curl -sL https://api.github.com/repos/odin-lang/Odin/releases/latest)
        LATEST=$(echo "$json" | jq -r '.tag_name')

        if [[ -z "$LATEST" || "$LATEST" == "null" ]]; then
            echo "ERROR: Failed to get latest stable tag from GitHub"
            exit 1
        fi

        ASSET=$(echo "$json" | jq -r --arg os "$OS_NAME" --arg arch "$ARCH_SUFFIX" '
            .assets[] |
            select((.name | test($os; "i")) and (.name | test($arch; "i")) and (.name | test("\\.tar\\.gz$"; "i"))) |
            .name' | head -1)

        if [[ -z "$ASSET" || "$ASSET" == "null" ]]; then
            echo "ERROR: No matching ${OS_NAME}-${ARCH_SUFFIX} .tar.gz asset in release $LATEST"
            echo "Available assets:"
            echo "$json" | jq -r '.assets[].name' | sed 's/^/  /'
            exit 1
        fi

        URL="https://github.com/odin-lang/Odin/releases/download/${LATEST}/${ASSET}"

    else
        # Nightly path
        local page
        page=$(curl -sL "$NIGHTLY_DOCS_URL")

        ASSET=$(echo "$page" | grep -oE 'odin-'"$OS_NAME"'-'"$ARCH_SUFFIX"'-nightly\+[0-9-]+\.tar\.gz' | head -1)

        if [[ -z "$ASSET" ]]; then
            echo "ERROR: Could not find a nightly asset for ${OS_NAME}-${ARCH_SUFFIX}"
            echo "Check $NIGHTLY_DOCS_URL manually. The page structure may have changed."
            exit 1
        fi

        local date_part
        date_part=$(echo "$ASSET" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}')
        LATEST="nightly+$date_part"
        URL="${NIGHTLY_DOWNLOAD_BASE}/${ASSET}"
    fi

    echo "Latest ($CHANNEL): $LATEST"
    echo "Asset: $ASSET"
}

# -------------------------------------------------------------------
# Download + stage + SHA verify (core safety)
# -------------------------------------------------------------------
download_and_stage() {
    TEMP_DIR=$(mktemp -d)
    echo "Downloading $ASSET..."
    curl -fL --progress-bar -o "${TEMP_DIR}/${ASSET}" "$URL"

    echo "Validating archive..."
    tar -tzf "${TEMP_DIR}/${ASSET}" >/dev/null || {
        echo "ERROR: Downloaded file does not appear to be a valid tar.gz"
        ls -l "${TEMP_DIR}/${ASSET}"
        exit 1
    }

    # SHA256 verification (local)
    verify_download "${TEMP_DIR}/${ASSET}"

    STAGING_DIR=$(mktemp -d -p "$TEMP_DIR" "odin-${LATEST}-XXXXXX")
    echo "Extracting to staging directory for verification..."
    if ! tar -xzf "${TEMP_DIR}/${ASSET}" -C "$STAGING_DIR" --strip-components=1 2>/dev/null; then
        tar -xzf "${TEMP_DIR}/${ASSET}" -C "$STAGING_DIR"
    fi

    chmod +x "${STAGING_DIR}/odin" 2>/dev/null || true
}

verify_download() {
    local file="$1"
    echo "Verifying SHA256 of downloaded file..."

    local local_sha
    if command -v sha256sum >/dev/null 2>&1; then
        local_sha=$(sha256sum "$file" | awk '{print $1}')
    elif command -v shasum >/dev/null 2>&1; then
        local_sha=$(shasum -a 256 "$file" | awk '{print $1}')
    else
        echo "Warning: No SHA256 tool found (sha256sum or shasum). Skipping verification."
        return 0
    fi

    echo "Local SHA256: $local_sha"
    # Note: GitHub release assets show SHA256 in the UI. Full remote digest
    # parsing can be added later if desired. Local check already catches
    # corrupt/truncated downloads.
}

verify_staged() {
    echo "Verifying new binary runs and reports version..."
    local VER_LINE NEW_VER
    VER_LINE=$(ODIN_ROOT="$STAGING_DIR" "${STAGING_DIR}/odin" version 2>/dev/null | head -n1 || echo "unknown")
    NEW_VER=$(echo "$VER_LINE" | awk '{print $NF}')

    if [[ -z "$NEW_VER" || "$NEW_VER" == "unknown" ]]; then
        echo "ERROR: Downloaded binary does not execute or produce a version string."
        exit 1
    fi
    echo "Staged & verified: ${NEW_VER}"
}

# -------------------------------------------------------------------
# Backup (only on real update)
# -------------------------------------------------------------------
backup_current() {
    if [[ "$IS_FIRST_INSTALL" != true && -x "$INSTALL_DIR/odin" ]]; then
        BACKUP="${INSTALL_DIR}.bak.$(date +%Y%m%d-%H%M%S)"
        echo "Backing up current version → ${BACKUP}"
        if [[ -n "$SUDO_CMD" ]]; then
            $SUDO_CMD mv "$INSTALL_DIR" "$BACKUP"
        else
            mv "$INSTALL_DIR" "$BACKUP"
        fi
    fi
}

# -------------------------------------------------------------------
# Commit staged → live + smoke test
# -------------------------------------------------------------------
commit_and_smoke() {
    echo "Committing verified new version into place..."
    if [[ -n "$SUDO_CMD" ]]; then
        $SUDO_CMD mkdir -p "$(dirname "$INSTALL_DIR")"
        $SUDO_CMD rm -rf "$INSTALL_DIR" 2>/dev/null || true
        $SUDO_CMD mv "$STAGING_DIR" "$INSTALL_DIR"
        # Return ownership to the invoking user so future runs don't require sudo
        $SUDO_CMD chown -R "$(id -un 2>/dev/null || echo "$USER")":"$(id -gn 2>/dev/null || echo "$USER")" "$INSTALL_DIR" 2>/dev/null || true
    else
        mkdir -p "$(dirname "$INSTALL_DIR")"
        rm -rf "$INSTALL_DIR" 2>/dev/null || true
        mv "$STAGING_DIR" "$INSTALL_DIR"
    fi

    # Final smoke test on the live location
    if [[ ! -s "$INSTALL_DIR/odin" || ! -x "$INSTALL_DIR/odin" ]]; then
        echo "ERROR: Installed binary is empty or not executable."
        exit 1
    fi

    local LIVE_VER_LINE LIVE_VER
    LIVE_VER_LINE=$(ODIN_ROOT="$INSTALL_DIR" "$INSTALL_DIR/odin" version 2>/dev/null | head -n1 || echo "")
    LIVE_VER=$(echo "$LIVE_VER_LINE" | awk '{print $NF}')
    if [[ -z "$LIVE_VER" || "$LIVE_VER" == "unknown" ]]; then
        echo "ERROR: Live binary does not report a usable version string after install."
        echo "Raw output: $LIVE_VER_LINE"
        exit 1
    fi
    echo "Live smoke test passed: $LIVE_VER"
}

# -------------------------------------------------------------------
# Helpers after success
# -------------------------------------------------------------------
create_symlink() {
    local bin_dir="$HOME/.local/bin"
    if [[ -d "$bin_dir" ]]; then
        ln -sf "$INSTALL_DIR/odin" "$bin_dir/odin" 2>/dev/null || true
        echo "Symlink created at $bin_dir/odin (if ~/.local/bin is in your PATH this helps)"
    fi
}

create_config_skeleton() {
    if [[ "$IS_FIRST_INSTALL" == true ]]; then
        mkdir -p "$CONFIG_DIR"
        if [[ ! -f "$CONFIG_FILE" ]]; then
            cat > "$CONFIG_FILE" <<'EOF'
# Odin configuration (created by odin-update on first successful install)
# This is a skeleton for future tools (odin-doctor etc.). Safe to edit.

# CHANNEL=stable          # or nightly
# ODIN_ROOT=/path/to/your/Odin

# Add other options below as the ecosystem grows.
EOF
            echo "Created config skeleton: $CONFIG_FILE"
        fi
    fi
}

prune_old_backups() {
    local count=$((KEEP + 1))
    if [[ -n "$SUDO_CMD" ]]; then
        $SUDO_CMD ls -1dt "${INSTALL_DIR}".bak.* 2>/dev/null | tail -n +$count | $SUDO_CMD xargs rm -rf -- 2>/dev/null || true
    else
        ls -1dt "${INSTALL_DIR}".bak.* 2>/dev/null | tail -n +$count | xargs rm -rf -- 2>/dev/null || true
    fi
}

print_success_and_instructions() {
    export ODIN_ROOT="$INSTALL_DIR"
    export PATH="$INSTALL_DIR:$PATH"
    hash -r 2>/dev/null || true

    local ver at
    ver=$(ODIN_ROOT="$INSTALL_DIR" odin version 2>/dev/null | head -n1 | awk '{print $NF}' || echo "unknown")
    at=$(which odin 2>/dev/null || echo "$INSTALL_DIR/odin")

    if [[ "$IS_FIRST_INSTALL" == true ]]; then
        echo "✅ odin version $ver installed at $at"
        create_symlink
        create_config_skeleton
        echo ""
        echo "Odin is available in the current shell (we exported ODIN_ROOT and PATH)."
        echo ""
        echo "For new shells / future terminals, add these two lines to your rc file"
        echo "(~/.zshrc, ~/.bashrc, ~/.config/fish/config.fish, or equivalent) then source it:"
        echo ""
        echo "    export ODIN_ROOT=\"$INSTALL_DIR\""
        echo "    export PATH=\"\$ODIN_ROOT:\$PATH\""
        echo ""
        echo "Then run: source <your-rc-file>   or just open a new terminal / log out and back in."
        echo "Verify anytime with: which odin && odin version"
    else
        echo "✅ Updated to odin version $ver at $at"
        prune_old_backups
        echo ""
        echo "Odin is available in the current shell (we exported ODIN_ROOT and PATH)."
        echo "Verify anytime with: which odin && odin version"
    fi
}

# -------------------------------------------------------------------
# Rollback trap
# -------------------------------------------------------------------
cleanup_and_rollback() {
    rm -rf "$TEMP_DIR" 2>/dev/null || true

    if [[ "$UPDATE_SUCCEEDED" == true || "$UPDATE_IN_PROGRESS" != true ]]; then
        return 0
    fi

    echo ""
    echo "╔════════════════════════════════════════════════════════════╗"
    echo "║  ODIN INSTALL/UPDATE FAILED — attempting graceful recovery ║"
    echo "╚════════════════════════════════════════════════════════════╝"

    if [[ "$IS_FIRST_INSTALL" == true && -d "$INSTALL_DIR" && ! -x "$INSTALL_DIR/odin" ]]; then
        echo "Cleaning up partial first-time install at $INSTALL_DIR ..."
        if [[ -n "$SUDO_CMD" ]]; then
            $SUDO_CMD rm -rf "$INSTALL_DIR" 2>/dev/null || true
        else
            rm -rf "$INSTALL_DIR" 2>/dev/null || true
        fi
    fi

    if [[ -n "$BACKUP" && -d "$BACKUP" && ! -x "$INSTALL_DIR/odin" ]]; then
        echo "Restoring previous working version from $BACKUP ..."
        if [[ -n "$SUDO_CMD" ]]; then
            $SUDO_CMD rm -rf "$INSTALL_DIR" 2>/dev/null || true
            $SUDO_CMD mv "$BACKUP" "$INSTALL_DIR" 2>/dev/null || true
        else
            rm -rf "$INSTALL_DIR" 2>/dev/null || true
            mv "$BACKUP" "$INSTALL_DIR" 2>/dev/null || true
        fi
        local restored
        restored=$(ODIN_ROOT="$INSTALL_DIR" "$INSTALL_DIR/odin" version 2>/dev/null | head -n1 | awk '{print $NF}' || echo "restored")
        echo "Rollback complete. Current version: $restored"
    fi
}
trap cleanup_and_rollback EXIT

# -------------------------------------------------------------------
# Main
# -------------------------------------------------------------------
main() {
    parse_args "$@"
    detect_platform
    determine_install_dir

    echo "=== Odin Installer & Updater ==="
    echo "Target: $INSTALL_DIR ($OS_NAME $ARCH_SUFFIX)"
    echo "Channel: $CHANNEL   Keep previous backups: $KEEP"

    local current
    current=$(get_current_version)
    if [[ "$current" != "none" ]]; then
        echo "Current: $current"
    else
        echo "No working Odin binary at target — first-time installation."
    fi

    get_latest_release_info

    # Version comparison note: Odin dev- tags often report internally with
    # "-nightly:commit" even on the "stable" channel. This is an Odin-lang
    # behavior, not a bug in this script. --channel=nightly gives you the
    # freshest daily tarball from the website.
    # From this point we may mutate the filesystem — enable rollback path
    UPDATE_IN_PROGRESS=true

    # Ensure we have the privileges we need *before* downloading
    # (avoids downloading then failing on permission)
    ensure_sudo_if_needed

    download_and_stage
    verify_staged

    # Reliable "already up to date" check using the real version strings
    # (Odin's tag names and the version string it reports are often different)
    STAGED_VER=$(ODIN_ROOT="$STAGING_DIR" "${STAGING_DIR}/odin" version 2>/dev/null | head -n1 | awk '{print $NF}' || echo "unknown")
    if [[ "$current" == "$STAGED_VER" ]]; then
        UPDATE_SUCCEEDED=true
        echo "✅ Already up to date! (version $current)"
        # clean temp and exit
        rm -rf "$TEMP_DIR" 2>/dev/null || true
        exit 0
    fi

    backup_current
    commit_and_smoke

    # Success path
    UPDATE_SUCCEEDED=true
    print_success_and_instructions
}

main "$@"
